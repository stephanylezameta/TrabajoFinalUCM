from trendspy import Trends
import time
import random
import pandas as pd

def consulta_con_reintentos(tr, keyword, timeframe, geo, max_intentos=3):
    for intento in range(1, max_intentos + 1):
        try:
            return tr.interest_over_time(keywords=keyword, timeframe=timeframe, geo=geo)
        except Exception as e:
            if "429" in str(e):
                espera = random.uniform(20, 40) * intento
                print(f"Intento {intento}: rate limit (429). Esperando {espera:.0f}s...")
                time.sleep(espera)
            else:
                raise
    raise Exception(f"No se pudo completar tras {max_intentos} intentos: {keyword}/{geo}")


def descargar_trends_destinos(keywords_por_destino, timeframe="today 3-m"):
    """
    Recorre cada destino x mercado emisor y arma un DataFrame único
    con la estructura: date, origin_market, destination, search_volume_index
    """
    tr = Trends()
    filas = []

    for destino, keywords_idioma in keywords_por_destino.items():
        for mercado, keyword in keywords_idioma.items():
            print(f"Descargando: {destino} / {mercado} ({keyword})")
            df = consulta_con_reintentos(tr, keyword, timeframe, mercado)

            for fecha, row in df.iterrows():
                filas.append({
                    "date": fecha.strftime("%Y-%m-%d"),
                    "origin_market": mercado,
                    "destination": destino,
                    "search_volume_index": row[keyword],
                })

            # Pausa aleatoria entre peticiones, como pedía el spec
            time.sleep(random.uniform(5, 10))

    return pd.DataFrame(filas)


if __name__ == "__main__":
    df_resultado = descargar_trends_destinos(KEYWORDS_POR_DESTINO)
    print(df_resultado.shape)
