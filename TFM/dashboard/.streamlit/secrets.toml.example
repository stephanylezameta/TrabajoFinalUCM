# Plantilla de secretos para Streamlit.
#
# Uso local:   copiar como .streamlit/secrets.toml y rellenar los valores.
# Uso en Streamlit Community Cloud: pegar este contenido en
#   Manage app -> Settings -> Secrets
#
# NUNCA subir secrets.toml al repositorio. El .gitignore ya lo excluye.

# ---------------------------------------------------------------------------
# API de recomendaciones de destinos de España (Azure Functions)
# ---------------------------------------------------------------------------
# Opción A (recomendada): base sin clave + clave aparte.
# La clave viaja en la cabecera x-functions-key, no en el querystring, así no
# queda registrada en logs de proxies ni en el historial del navegador.
TUI_RECO_API_BASE = "https://<tu-function-app>.azurewebsites.net/api/recommendations"
TUI_RECO_API_KEY = "<function-key>"

# Opción B: URL completa con ?code=<function-key> incluido.
# TUI_RECO_API_URL = "https://<tu-function-app>.azurewebsites.net/api/recommendations?code=<function-key>"

# Segundos de espera. La Function tiene arranque en frío: 30 s es un valor seguro.
TUI_RECO_API_TIMEOUT = "30"

# ---------------------------------------------------------------------------
# Asistente conversacional (opcional)
# Sin endpoint configurado, el asistente usa su intérprete local.
# ---------------------------------------------------------------------------
# TUI_AI_ENDPOINT = "https://<tu-endpoint>/chat"
# TUI_AI_API_KEY = "<api-key>"
# TUI_AI_TIMEOUT = "20"

# ---------------------------------------------------------------------------
# Búsqueda de imágenes en Wikipedia (opcional)
# ---------------------------------------------------------------------------
# TUI_IMAGE_USER_AGENT = "TUI-Data-Intelligence/1.0 (contacto@ejemplo.com)"
# TUI_IMAGE_TIMEOUT_SECONDS = "2"
