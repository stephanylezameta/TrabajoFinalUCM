# Plantilla de secretos para Streamlit.
#
# Uso local:   copiar como .streamlit/secrets.toml y rellenar los valores.
# Uso en Streamlit Community Cloud: pegar este contenido en
#   Manage app -> Settings -> Secrets
#
# NUNCA subir secrets.toml al repositorio. El .gitignore ya lo excluye.

# ---------------------------------------------------------------------------
# Motor de recomendación TUI (API FastAPI en Azure Container Apps)
# ---------------------------------------------------------------------------
# URL base del motor. De ella cuelgan los endpoints /recomendar, /chat y
# /tdrs_ranking. La misma variable sirve en local y en Streamlit Cloud.
TUI_MODELO_API_BASE = "https://javier-tui-recomendador-api.greenbush-59ba65d9.eastus2.azurecontainerapps.io"

# Segundos de espera. El servicio corre con min-replicas: 1 (sin arranque en
# frío), pero se deja margen holgado por seguridad.
TUI_MODELO_API_TIMEOUT = "90"

# ---------------------------------------------------------------------------
# (Opcional) API antigua de recomendaciones (Azure Functions) — respaldo.
# Solo se usa si NO se define TUI_MODELO_API_BASE.
# ---------------------------------------------------------------------------
# TUI_RECO_API_BASE = "https://<tu-function-app>.azurewebsites.net/api/recommendations"
# TUI_RECO_API_KEY = "<function-key>"
# TUI_RECO_API_TIMEOUT = "30"

# ---------------------------------------------------------------------------
# Búsqueda de imágenes en Wikipedia (opcional)
# ---------------------------------------------------------------------------
# TUI_IMAGE_USER_AGENT = "TUI-Data-Intelligence/1.0 (contacto@ejemplo.com)"
# TUI_IMAGE_TIMEOUT_SECONDS = "2"
